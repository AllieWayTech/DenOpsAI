[Unit]
Description=DenOps AI builder administrative web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pingpassport
Group=pingpassport
WorkingDirectory=/opt/denops-ai
Environment=PYTHONPATH=/opt/denops-ai/src
EnvironmentFile=/etc/denops-ai/web.env
EnvironmentFile=/etc/denops-ai/openai.env
Environment=DENOPS_AI_PROVIDER=openai
Environment=DENOPS_AI_MODEL=gpt-6-sol
Environment=DENOPS_AI_OPENAI_ENABLED=1
Environment=DENOPS_AI_DAILY_CALL_LIMIT=1
Environment=DENOPS_AI_MAX_OUTPUT_TOKENS=800
ExecStart=/opt/denops-ai/.venv/bin/python -m denops_ai_builder --root /opt/denops-ai --serve --host 192.168.1.13 --port 8080
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/denops-ai/tasks /opt/denops-ai/state
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
